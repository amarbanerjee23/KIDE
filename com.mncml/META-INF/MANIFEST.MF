Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: com.mncml;singleton:=true
Automatic-Module-Name: com.mncml
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-1.7
Export-Package: mncModel,
 mncModel.impl,
 mncModel.util,
 mncModel.utility,
 mncModel.utility.impl,
 mncModel.utility.util
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 com.dml;bundle-version="0.1.0";visibility:=reexport,
 com.operation;visibility:=reexport
Bundle-ActivationPolicy: lazy
