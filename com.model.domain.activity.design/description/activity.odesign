  <ownedViewpoints name="ActivityFlowDiagrams" modelFileExtension="activity">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="ActivityDescriptionDiagram" titleExpression="service:getActivityTitle()" domainClass="activityDiagramModel.Activity" preconditionExpression="service:singleActivityRepresentationCheckForActivity()" enablePopupBars="true">
      <layout xsi:type="description_1:CompositeLayout" padding="10"/>
      <defaultLayer name="ActivityLayer">
