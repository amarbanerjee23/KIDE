        <nodeMappings name="EndPoint" deletionDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='DeleteElement']" labelDirectEdit="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='EditFinalOutcomes']" semanticCandidatesExpression="service:getEndPointForOutcomes()" doubleClickDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='ElementsDoubleClick']" domainClass="activityDiagramModel.Outcome">
          <style xsi:type="style:DotDescription" borderSizeComputationExpression="10" showIcon="false" tooltipExpression="feature:name" sizeComputationExpression="aql:self.name.size()" labelPosition="node" resizeKind="NSEW" strokeSizeComputationExpression="aql:self.name.size()">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
