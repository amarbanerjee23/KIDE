        <containerMappings name="Activity" deletionDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='DeleteElement']" labelDirectEdit="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='EditActivityName']" semanticCandidatesExpression="aql:self.activities" doubleClickDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='ElementsDoubleClick']" synchronizationLock="true" domainClass="activityDiagramModel.Activity" childrenPresentation="VerticalStack">
          <subContainerMappings name="Child Activity Diagram Container" semanticCandidatesExpression="feature:childActivityDiagram" doubleClickDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='Child%20Activity%20Diagram']" domainClass="activityDiagramModel.ActivityDiagram">
            <style xsi:type="style:WorkspaceImageDescription" borderSizeComputationExpression="3" borderLineStyle="dash_dot" showIcon="false" tooltipExpression="feature:name" roundedCorner="true" workspacePath="/com.model.domain.activity.design/icons/child-activity-diagram.png">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
              <labelFormat>bold</labelFormat>
              <labelFormat>underline</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </subContainerMappings>
          <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="1">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
