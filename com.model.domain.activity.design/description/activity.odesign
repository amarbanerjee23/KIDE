            <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          </style>
        </containerMappings>
        <toolSections name="ActivityDiagramSection">
          <ownedTools xsi:type="tool:ReconnectEdgeDescription" name="ReconnectBetweenConditionsAndActivities" reconnectionKind="RECONNECT_BOTH">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:Unset" featureName="onTrueNextActivity" elementExpression="var:preTarget">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="onTrueNextActivity" valueExpression="var:target"/>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
          <ownedTools xsi:type="tool:ReconnectEdgeDescription" name="ReconnectBetweenConditionsAndFinalOutcomes" reconnectionKind="RECONNECT_BOTH">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:Unset" featureName="onTrueFinalOutCome" elementExpression="var:preTarget">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="onTrueFinalOutCome" valueExpression="var:target"/>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
          <ownedTools xsi:type="tool:DeleteElementDescription" name="DeleteElement">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool_1:RemoveElement"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DirectEditLabel" name="EditActivityName" forceRefresh="true">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:0"/>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DirectEditLabel" name="EditConditionOutcome">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="feature:outcome">
                <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="feature:name">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:0"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DirectEditLabel" name="EditFinalOutcomes">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:0"/>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="Create Activity" containerMappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@containerMappings[name='Activity']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:CreateInstance" typeName="activityDiagramModel.Activity" referenceName="activities">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'Activity '+self.siblings()->size()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DoubleClickDescription" name="ElementsDoubleClick" elementsToSelect="var:self" mappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@containerMappings[name='Activity'] //@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='ConditionNode'] //@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='EndPoint']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="service:openTextEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DoubleClickDescription" name="Child Activity Diagram" mappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@containerMappings[name='Activity']/@subContainerMappings[name='Child%20Activity%20Diagram%20Container']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="service:openChildActivityDiagramForAnActivity()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="com.model.domain.activity.design.services.ActivityDiagramServices"/>
