        <edgeMappings name="nextActivity" deletionDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='DeleteElement']" sourceMapping="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='ConditionNode']" targetMapping="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@containerMappings[name='Activity']" targetFinderExpression="service:getNextActivityForAnActivityCondition()" reconnections="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='ReconnectBetweenConditionsAndActivities']">
          <style sizeComputationExpression="2" routingStyle="manhattan" endsCentering="Both" centeredSourceMappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='ConditionNode']" centeredTargetMappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@containerMappings[name='Activity']">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression=" Yes">
