    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="ActivityDiagram" titleExpression="service:getActivityDiagramTitle()" initialisation="true" domainClass="activityDiagramModel.ActivityDiagram" preconditionExpression="service:singleActivityRepresentationCheckForActivityDiagram()" enablePopupBars="true">
