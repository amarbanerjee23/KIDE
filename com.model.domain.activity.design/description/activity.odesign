        <edgeMappings name="endEdge" deletionDescription="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='DeleteElement']" synchronizationLock="true" sourceMapping="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='ConditionNode']" targetMapping="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='EndPoint']" targetFinderExpression="service:getFinalOutcomes()" reconnections="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='ReconnectBetweenConditionsAndFinalOutcomes']">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2" routingStyle="manhattan" endsCentering="Both" centeredSourceMappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='ConditionNode']" centeredTargetMappings="//@ownedViewpoints[name='ActivityFlowDiagrams']/@ownedRepresentations[name='ActivityDiagram']/@defaultLayer/@nodeMappings[name='EndPoint']">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="Yes">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
