module com.mncml.dsl.GenerateMnc

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*
import  org.eclipse.xtext.generator.serializer

var rootPath = ".."

Workflow {
	
	component = XtextGenerator {
		configuration = {
			project = StandardProjectConfig {
				baseName = "com.mncml.dsl"
				rootPath = rootPath
				eclipsePlugin = {
					enabled = true
				}
				createEclipseMetaData = true
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
			}
		}
		
		language = StandardLanguage {
			name = "com.mncml.dsl.Mnc"
			fileExtensions = "mncspec"
			referencedResource = "platform:/resource/com.mncml/model/mnc.genmodel"
			referencedResource = "platform:/resource/com.dml/model/DML.genmodel"
			referencedResource = "platform:/resource/com.operation/model/operations.genmodel"
			
			fragment = ecore2xtext.Ecore2XtextValueConverterServiceFragment2 auto-inject {}

			formatter = {
				generateStub = true
			}

			serializer = {
				generateStub = true 
				generateXtendStub=true
				
							
			}  
			
						
			scopeProvider = {
				generateStub = true
			}
			validator = {
				// composedCheck = "org.eclipse.xtext.validation.NamesAreUniqueValidator"
				// Generates checks for @Deprecated grammar annotations, an IssueProvider and a corresponding PropertyPage
				generateDeprecationValidation = true
			}
			
		}
	}
}
