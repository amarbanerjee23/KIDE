	@Check
	def checkValidIPAdrress(Address address) {
		val String[] segments = address.ipaddress.split("\\.")
		var bool = false
		for (j : 0 ..< segments.size) {
			var value = Integer.parseInt(segments.get(j))
			if (value < 0 || value > 255)
				bool = true
		}
		if (bool)
			error("IPAddress '" + address.ipaddress + "' is invalid.", MncModelPackage.Literals.ADDRESS__IPADDRESS)
	}

