	@Check
	def checkSubscribedItemsDifferentFromInterfaceDescriptionItems(SubscribableItemList subscribableItemList) {
		val interfaceDescription = subscribableItemList.getContainerOfType(InterfaceDescription)
		// Validate for Subscribed Alarms
		if (subscribableItemList.subscribedAlarms !== null) {
			for (alarm : subscribableItemList.subscribedAlarms) {
				if (interfaceDescription.alarms.contains(alarm)) {
					error("Subscribed Alarms should be different from the alarm in Interface Description",
						MncModelPackage.Literals.SUBSCRIBABLE_ITEM_LIST__SUBSCRIBED_ALARMS,
						subscribableItemList.subscribedAlarms.indexOf(alarm))
				}
				if (!alarm.isPublish) {
					error("Alarm is not published", MncModelPackage.Literals.SUBSCRIBABLE_ITEM_LIST__SUBSCRIBED_ALARMS,
						subscribableItemList.subscribedAlarms.indexOf(alarm))
				}

			}
		}

		// Validate for Subscribed Events
		if (subscribableItemList.subscribedEvents !== null) {
			for (event : subscribableItemList.subscribedEvents) {
				if (interfaceDescription.events.contains(event)) {
					error("Subscribed Events should be different from the event in Interface Description",
						MncModelPackage.Literals.SUBSCRIBABLE_ITEM_LIST__SUBSCRIBED_EVENTS,
						subscribableItemList.subscribedEvents.indexOf(event))
				}
				if (!event.isPublish) {
					error("Event is not published", MncModelPackage.Literals.SUBSCRIBABLE_ITEM_LIST__SUBSCRIBED_ALARMS,
						subscribableItemList.subscribedEvents.indexOf(event))
				}

			}
		}

		// Validate for Subscribed DataPoints
		if (subscribableItemList.subscribedDataPoints !== null) {
			for (dataPoint : subscribableItemList.subscribedDataPoints) {
				if (interfaceDescription.dataPoints.contains(dataPoint)) {
					error("Subscribed DataPoints should be different from the datapoint in Interface Description",
						MncModelPackage.Literals.SUBSCRIBABLE_ITEM_LIST__SUBSCRIBED_DATA_POINTS,
						subscribableItemList.subscribedDataPoints.indexOf(dataPoint))
				}
				if (!dataPoint.publish) {
					error("Datapoint is not published",
						MncModelPackage.Literals.SUBSCRIBABLE_ITEM_LIST__SUBSCRIBED_ALARMS,
						subscribableItemList.subscribedDataPoints.indexOf(dataPoint))
				}

			}
		}

	}

