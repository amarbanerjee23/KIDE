	@Check
	def checkNoCommandCallsItSelfInTransition(Action action) {
		var commandResponseBlock = action.getContainerOfType(CommandResponseBlock)
		if (commandResponseBlock !== null && commandResponseBlock.action !== null && commandResponseBlock.action.transitionStates !== null) {
			var transitions = commandResponseBlock.action.transitionStates
			for (transition : transitions) {
				if (transition.entryAction !== null && transition.entryAction.fireCommand !== null) {
					if (transition.entryAction.fireCommand.contains(commandResponseBlock.command) ||
						transition.exitAction.fireCommand.contains(commandResponseBlock.command)) {
						warning("Command calls itself as part of transition actions.",
							MncModelPackage.Literals.ACTION__FIRE_COMMAND)
					}
				}

			}
		}

	}

	@Check
	def checkNoCommandCallsItAction(Action action) {
		var commandResponseBlock = EcoreUtil2.getContainerOfType(action, CommandResponseBlock)
		var eventBlock = EcoreUtil2.getContainerOfType(action, EventBlock)
		var alarmBlock = EcoreUtil2.getContainerOfType(action, AlarmBlock)
		var dataPointBlock = EcoreUtil2.getContainerOfType(action, DataPointBlock)

		if (commandResponseBlock !== null) {
			if (action.fireCommand !== null && action.fireCommand.contains(commandResponseBlock.command)) {
				warning("Command fired itself in actions.", MncModelPackage.Literals.ACTION__FIRE_COMMAND)
			}
		}
		if (eventBlock !== null) {
			if (action.publishEvent !== null && action.publishEvent.contains(eventBlock.event)) {
				warning("Event published itself in actions.", MncModelPackage.Literals.ACTION__PUBLISH_EVENT)
			}
		}
		if (alarmBlock !== null) {
			if (action.raiseAlarm !== null && action.raiseAlarm.contains(alarmBlock.alarm)) {
				warning("Alarm raises itself in actions.", MncModelPackage.Literals.ACTION__RAISE_ALARM)
			}
		}
		if (dataPointBlock !== null) {
			if (action.triggerDataPoint !== null && action.triggerDataPoint.contains(dataPointBlock.dataPoint)) {
				warning("DataPoint triggers itself in actions.", MncModelPackage.Literals.ACTION__TRIGGER_DATA_POINT)
			}
		}

	}

