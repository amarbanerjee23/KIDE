 com.mncml.dsl.ide;bundle-version="1.0.0",
 com.operation.dsl.ide;bundle-version="1.0.0",
 com.smr.activity.dsl.ide;bundle-version="1.0.0"
Import-Package: com.google.inject,
 com.google.inject.util,
 org.osgi.framework
Export-Package: com.kide.languageserver
