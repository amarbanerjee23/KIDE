Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: com.smr.activity;singleton:=true
Automatic-Module-Name: com.smr.activity
Bundle-Version: 1.0.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: activityDiagramModel,
 activityDiagramModel.impl,
 activityDiagramModel.util
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 com.dml;visibility:=reexport,
 com.mncml;visibility:=reexport,
 com.operation;visibility:=reexport,
 com.capability;bundle-version="0.1.0";visibility:=reexport
Bundle-ActivationPolicy: lazy
