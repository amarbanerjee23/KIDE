{
  "schema_version": 1,
  "registry_root_env": "KIDE_HOSTED_PROJECTS_ROOT",
  "slot_layout": "<project-uuid>/{project,workspace}",
  "max_projects": 512,
  "dynamic_consumers": [
    "xtext-lsp",
    "glsp"
  ],
  "legacy_single_project_fallback": true,
  "project_creation_enabled": false,
  "requirements": [
    "no-symbolic-link-registry-entries",
    "slot-name-matches-project-uuid",
    "unique-project-id",
    "unique-workspace-id",
    "registry-rescanned-on-workspace-resolution",
    "role-binding-scope-must-exist-in-registry"
  ]
}
