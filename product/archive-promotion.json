{
  "schema_version": 1,
  "operation_id": "importProjectArchive",
  "route": "/api/v1/projects/{projectId}/imports/archive",
  "method": "POST",
  "target_policy": "REQUIRE_EMPTY",
  "content_encoding": "base64",
  "max_files": 256,
  "max_file_bytes": 2097152,
  "max_total_bytes": 10485760,
  "max_request_bytes": 16777216,
  "forbidden_hosted_prefixes": [
    ".kide/"
  ],
  "post_promotion_services": [
    "xtext-lsp",
    "glsp",
    "collaboration",
    "synthesis",
    "reconfiguration",
    "generation"
  ]
}
