{
  "schema_version": 1,
  "baseline": {
    "xtext": "2.25.x target platform",
    "purpose": "Freeze client-neutral editor behavior before PR15/PR16 modernization"
  },
  "features": [
    {
      "id": "diagnostics",
      "qualification": "required",
      "capability": null
    },
    {
      "id": "completion",
      "qualification": "required",
      "capability": "completionProvider"
    },
    {
      "id": "hover",
      "qualification": "required",
      "capability": "hoverProvider"
    },
    {
      "id": "definition",
      "qualification": "required_where_applicable",
      "capability": "definitionProvider"
    },
    {
      "id": "references",
      "qualification": "required",
      "capability": "referencesProvider"
    },
    {
      "id": "document_symbols",
      "qualification": "required",
      "capability": "documentSymbolProvider"
    },
    {
      "id": "workspace_symbols",
      "qualification": "required",
      "capability": "workspaceSymbolProvider"
    },
    {
      "id": "formatting",
      "qualification": "required",
      "capability": "documentFormattingProvider"
    },
    {
      "id": "rename",
      "qualification": "required",
      "capability": "renameProvider"
    },
    {
      "id": "folding",
      "qualification": "deferred",
      "capability": "foldingRangeProvider",
      "reason": "The packaged Xtext 2.25 server does not advertise foldingRangeProvider; PR16 must promote this only after the platform upgrade exposes and qualifies it."
    },
    {
      "id": "snippets",
      "qualification": "deferred",
      "capability": null,
      "reason": "not separately qualified on the legacy Xtext baseline"
    },
    {
      "id": "code_actions",
      "qualification": "deferred",
      "capability": "codeActionProvider",
      "reason": "existing Eclipse quick fixes are UI-layer implementations and are not yet proven headless"
    },
    {
      "id": "semantic_tokens",
      "qualification": "deferred",
      "capability": "semanticTokensProvider",
      "reason": "not part of the qualified Xtext 2.25 KIDE baseline"
    },
    {
      "id": "declaration",
      "qualification": "deferred",
      "capability": "declarationProvider",
      "reason": "not part of the qualified Xtext 2.25 KIDE baseline"
    },
    {
      "id": "type_definition",
      "qualification": "deferred",
      "capability": "typeDefinitionProvider",
      "reason": "not part of the qualified Xtext 2.25 KIDE baseline"
    },
    {
      "id": "implementation",
      "qualification": "deferred",
      "capability": "implementationProvider",
      "reason": "not part of the qualified Xtext 2.25 KIDE baseline"
    }
  ],
  "languages": {
