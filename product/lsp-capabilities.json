{
  "schema_version": 1,
  "baseline": {
    "xtext": "2.44.0 current platform",
    "purpose": "Qualify client-neutral editor behavior for every production KIDE DSL"
  },
  "features": [
    {
      "id": "diagnostics",
      "qualification": "required",
      "capability": null
    },
    {
      "id": "completion",
      "qualification": "required",
      "capability": "completionProvider"
    },
    {
      "id": "hover",
      "qualification": "required",
      "capability": "hoverProvider"
    },
    {
      "id": "definition",
      "qualification": "required_where_applicable",
      "capability": "definitionProvider"
    },
    {
      "id": "references",
      "qualification": "required",
      "capability": "referencesProvider"
    },
    {
      "id": "document_symbols",
      "qualification": "required",
      "capability": "documentSymbolProvider"
    },
    {
      "id": "workspace_symbols",
      "qualification": "required",
      "capability": "workspaceSymbolProvider"
    },
    {
      "id": "formatting",
      "qualification": "required",
      "capability": "documentFormattingProvider"
    },
    {
      "id": "rename",
      "qualification": "required",
      "capability": "renameProvider"
    },
    {
      "id": "folding",
      "qualification": "required",
      "capability": "foldingRangeProvider"
    },
    {
      "id": "snippets",
      "qualification": "not_applicable",
      "capability": null,
      "reason": "KIDE Eclipse ships no separate snippet service; snippet-shaped completion items remain supported through completion."
    },
    {
      "id": "code_actions",
      "qualification": "required_where_applicable",
      "capability": "codeActionProvider"
    },
    {
      "id": "semantic_tokens",
      "qualification": "required_where_applicable",
      "capability": "semanticTokensProvider"
    },
    {
      "id": "declaration",
      "qualification": "not_applicable",
      "capability": "declarationProvider",
      "reason": "KIDE Eclipse uses hyperlink/definition navigation and has no distinct declaration service."
    },
    {
      "id": "type_definition",
      "qualification": "not_applicable",
      "capability": "typeDefinitionProvider",
      "reason": "KIDE DSL model elements do not expose a distinct Eclipse type-definition navigation service."
    },
    {
      "id": "implementation",
      "qualification": "not_applicable",
      "capability": "implementationProvider",
      "reason": "KIDE DSL model elements do not expose a distinct Eclipse implementation-navigation service."
    },
    {
      "id": "document_highlights",
      "qualification": "required",
      "capability": "documentHighlightProvider"
    },
    {
      "id": "range_formatting",
      "qualification": "required",
      "capability": "documentRangeFormattingProvider"
    },
    {
      "id": "signature_help",
      "qualification": "not_applicable",
      "capability": "signatureHelpProvider",
      "reason": "The KIDE Eclipse DSL editors do not ship a separate signature-help/parameter-hints semantic service; Xtext's default LSP service is intentionally no-op."
    }
  ],
  "languages": {
    "dml": {
      "symbol": "Payload",
      "hover_token": "Payload",
      "references_min": 0,
      "folding_min": 1,
      "rename_targets": [
        "parity.dml"
      ],
      "completion": {
        "text": "DataModel CompletionProbe {\n  primitives { ",
        "position": {
          "line": 1,
          "character": 15
        }
      },
      "semantic_tokens_min": 0,
      "document_highlights_min": 1
    },
    "operation": {
      "symbol": "Inspect",
      "hover_token": "Inspect",
      "references_min": 0,
      "folding_min": 0,
      "rename_targets": [
        "parity.op"
      ],
      "completion": {
        "text": "Operation CompletionProbe () {\n",
        "position": {
          "line": 1,
          "character": 0
        }
      },
      "semantic_tokens_min": 0,
      "document_highlights_min": 1
    },
    "mnc": {
      "symbol": "Device",
      "hover_token": "Device",
      "references_min": 1,
      "folding_min": 1,
      "rename_targets": [
        "parity.mncspec",
        "parity.cap"
      ],
      "completion": {
        "text": "Model CompletionProbe\nInterfaceDescription Device {\n",
        "position": {
          "line": 2,
          "character": 0
        }
      },
      "semantic_tokens_min": 1,
      "document_highlights_min": 1,
      "code_action": {
        "diagnostic_code": "invalidName",
        "title": "Capitalize name",
        "replacement": "Node"
      }
    },
    "capability": {
      "symbol": "Observe",
      "hover_token": "Observe",
      "references_min": 1,
      "folding_min": 1,
      "rename_targets": [
        "parity.cap",
        "parity.activity"
      ],
      "definition": {
        "token": "Device",
        "target_extension": "mncspec"
      },
      "completion": {
        "text": "Capability CompletionProbe compatible component interface Device {\n",
        "position": {
          "line": 1,
          "character": 0
        }
      },
      "semantic_tokens_min": 1,
      "document_highlights_min": 1,
      "code_action": {
        "diagnostic_code": "invalidControlCapabilitiesCommand",
        "title": "Remove this command",
        "replacement": ""
      }
    },
    "activity": {
      "symbol": "GoldenWorkflow",
      "hover_token": "Observe",
      "references_min": 0,
      "folding_min": 1,
      "rename_targets": [
        "parity.activity"
      ],
      "definition": {
        "token": "Observe",
        "target_extension": "cap",
        "occurrence": 2
      },
      "completion": {
        "text": "ActivityDiagram CompletionProbe has activities { Activity Step {\n",
        "position": {
          "line": 1,
          "character": 0
        }
      },
      "semantic_tokens_min": 1,
      "document_highlights_min": 1,
      "code_action": {
        "diagnostic_code": "invalidControlCapability",
        "title": "Remove this control item",
        "replacement": ""
      }
    },
    "krl": {
      "symbol": "GoldenKrl",
      "hover_token": "JavaBinding",
      "references_min": 0,
      "folding_min": 1,
      "rename_targets": [
        "parity.krl"
      ],
      "definition": {
        "token": "JavaBinding",
        "target_extension": "krl",
        "occurrence": 2
      },
      "completion": {
        "text": "knowledge CompletionProbe {\n",
        "position": {
          "line": 1,
          "character": 0
        }
      },
      "document_symbol": "GoldenKrl",
      "workspace_symbol": "GoldenKrl",
      "semantic_tokens_min": 0,
      "document_highlights_min": 1
    }
  }
}
