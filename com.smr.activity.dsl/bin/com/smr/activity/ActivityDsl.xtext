		('interrupts' '(' interrupts+=[activitydiagram::Activity|QualifiedName] ("," interrupts+=[activitydiagram::Activity|QualifiedName])*')')?
	'}';  
	 
ConditionalActivity returns activitydiagram::ConditionalActivity:
	{activitydiagram::ConditionalActivity} 
