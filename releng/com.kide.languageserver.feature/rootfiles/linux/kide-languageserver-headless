#!/bin/sh
# Start KIDE headless applications through Equinox's Java launcher, bypassing
# the GTK native launcher so CI/server workloads do not need X11/Wayland.
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# JustJ publishes more than one Linux runtime flavour (for example `minimal`
# and `full.stripped`). Bind to the packaged runtime and never fall back to
# system Java: the standalone service contract requires its embedded runtime.
JAVA=""
for candidate in "$BASE_DIR"/plugins/org.eclipse.justj.openjdk.hotspot.jre.*.linux.x86_64_*/jre/bin/java; do
  if [ -x "$candidate" ]; then
    JAVA=$candidate
    break
  fi
done
if [ -z "$JAVA" ]; then
  echo "KIDE headless runtime: bundled JustJ Linux x86_64 Java runtime was not found" >&2
  exit 70
fi

EQUINOX_LAUNCHER=""
for candidate in "$BASE_DIR"/plugins/org.eclipse.equinox.launcher_*.jar; do
  if [ -f "$candidate" ]; then
    EQUINOX_LAUNCHER=$candidate
    break
  fi
done
if [ -z "$EQUINOX_LAUNCHER" ]; then
  echo "KIDE headless runtime: Equinox launcher JAR was not found" >&2
  exit 70
fi

# Normal invocation starts the language server. Packaged qualification and
# service entrypoints may supply their own -application value (for example the
# secure gateway/API self-checks). Never prepend the default application when an
# explicit application was requested: Equinox uses the first occurrence.
HAS_APPLICATION=false
for argument in "$@"; do
  if [ "$argument" = "-application" ]; then
    HAS_APPLICATION=true
    break
  fi
done

if [ "$HAS_APPLICATION" = "true" ]; then
  exec "$JAVA" \
    -Xms128m \
    -Xmx1024m \
    -XX:+UseG1GC \
    -Dosgi.requiredJavaVersion=21 \
    -jar "$EQUINOX_LAUNCHER" \
    -configuration "$BASE_DIR/configuration" \
    -nosplash \
    "$@"
fi

exec "$JAVA" \
  -Xms128m \
  -Xmx1024m \
  -XX:+UseG1GC \
  -Dosgi.requiredJavaVersion=21 \
  -jar "$EQUINOX_LAUNCHER" \
  -configuration "$BASE_DIR/configuration" \
  -nosplash \
  -application com.kide.languageserver.application \
  "$@"
