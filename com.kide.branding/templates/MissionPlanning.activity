ActivityDiagram MissionPlanning
has activities {
	Activity ApproachDock {
		description : "Move the truck to the loading dock"
		requireCapability : Loading { StartLoading }
		nextActivity : LoadCargo
		time : 30.0 secs
	},
	Activity LoadCargo {
		description : "Transfer the cargo onto the truck"
		requireCapability : Loading { StopLoading }
		nextActivity : ConfirmLoad
		time : 120.0 secs
	},
	Activity ConfirmLoad {
		description : "Wait for the loading confirmation"
		requireCapability : Loading { StopLoading }
		conditions {
			from LoadingAccepted => nextActivity : LoadCargo
		}
	}
}
