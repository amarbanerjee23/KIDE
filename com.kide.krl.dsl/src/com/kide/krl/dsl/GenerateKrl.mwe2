module com.kide.krl.dsl.GenerateKrl

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {
    component = XtextGenerator {
        configuration = {
            project = StandardProjectConfig {
                baseName = "com.kide.krl.dsl"
                rootPath = rootPath
                genericIde = {
                    enabled = true
                }
                eclipsePlugin = {
                    enabled = true
                }
                createEclipseMetaData = false
            }
            code = {
                encoding = "UTF-8"
                lineDelimiter = "\n"
                preferXtendStubs = false
                fileHeader = "/* generated by Xtext \${version} for KIDE PR38 */"
            }
        }
        language = StandardLanguage {
            name = "com.kide.krl.dsl.Krl"
            fileExtensions = "krl"
            formatter = {
                generateStub = false
            }
            serializer = {
                generateStub = false
            }
            validator = {
                generateStub = false
            }
        }
    }
}
