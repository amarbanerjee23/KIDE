server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    # PR91: deny embedding, MIME sniffing and browser capability escalation.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    # SPA fallback internally resolves to /index.html. Revalidate the shell and
    # build stamp after deployment instead of serving an old frontend against
    # a newly deployed backend.
    location = /index.html {
        expires -1;
    }

    location = /kide-version.json {
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
