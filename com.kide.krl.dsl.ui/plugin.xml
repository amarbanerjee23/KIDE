<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.editors">
    <editor
      class="com.kide.krl.dsl.ui.KrlExecutableExtensionFactory:org.eclipse.xtext.ui.editor.XtextEditor"
      contributorClass="org.eclipse.ui.editors.text.TextEditorActionContributor"
      default="true"
      extensions="krl"
      id="com.kide.krl.dsl.Krl"
      name="KIDE Knowledge Representation Language Editor"/>
  </extension>
  <extension point="org.eclipse.core.contenttype.contentTypes">
    <content-type
      base-type="org.eclipse.core.runtime.text"
      file-extensions="krl"
      id="com.kide.krl.dsl.Krl.contenttype"
      name="KIDE KRL File"
      priority="normal"/>
  </extension>
  <extension point="org.eclipse.emf.ecore.extension_parser">
    <parser
      class="com.kide.krl.dsl.ui.KrlExecutableExtensionFactory:org.eclipse.xtext.resource.IResourceFactory"
      type="krl"/>
  </extension>
  <extension point="org.eclipse.xtext.extension_resourceServiceProvider">
    <resourceServiceProvider
      class="com.kide.krl.dsl.ui.KrlExecutableExtensionFactory:org.eclipse.xtext.ui.resource.IResourceUIServiceProvider"
      uriExtension="krl"/>
  </extension>
  <extension point="org.eclipse.xtext.builder.participant">
    <participant
      class="com.kide.krl.dsl.ui.KrlExecutableExtensionFactory:org.eclipse.xtext.builder.IXtextBuilderParticipant"
      fileExtensions="krl"/>
  </extension>
  <extension point="org.eclipse.team.core.fileTypes">
    <fileTypes extension="krl" type="text"/>
  </extension>
</plugin>
