{
  "name": "AssemblySupervisor",
  "defaultOperatingStates": ["IDLE", "RUNNING", "STOPPED", "FAULT"],
  "activities": [
    {
      "name": "PickPart",
      "requiresOperation": true,
      "parameters": ["partType"],
      "commands": ["pick"],
