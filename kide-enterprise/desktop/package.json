{
  "name": "kide-enterprise-desktop",
  "version": "1.0.0",
  "description": "KIDE Enterprise — Desktop Application for Industrial Control Software Automation",
  "main": "main.js",
  "author": "KIDE Enterprise",
  "license": "PROPRIETARY",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env KIDE_DEV=1 electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.kide.enterprise",
    "productName": "KIDE Enterprise",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend-dist/**/*",
      "icon.*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!__pycache__/**", "!*.pyc", "!.venv/**"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png",
      "category": "Development"
    }
  }
}
