Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: com.capability;singleton:=true
Automatic-Module-Name: com.capability
Bundle-Version: 0.1.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: CapabilityDescription,
 CapabilityDescription.impl,
 CapabilityDescription.util
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 com.dml;visibility:=reexport,
 com.mncml;visibility:=reexport,
 com.operation;visibility:=reexport
Bundle-ActivationPolicy: lazy
