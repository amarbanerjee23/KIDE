          <ownedTools xsi:type="tool:DoubleClickDescription" name="showStateDiagramDoubleClick" mappings="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@containerMappings[name='OuterMostLayer']/@subContainerMappings[name='showStateDiagram']">
