          <style xsi:type="style:EllipseNodeDescription" borderSizeComputationExpression="5" showIcon="false" labelExpression="" tooltipExpression="EndingPoint" hideLabelByDefault="true" labelPosition="node" resizeKind="NSEW">
            <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.10"/>
            <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <color xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
          </style>
        </nodeMappings>
        <edgeMappings name="StateTransition" sourceMapping="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@containerMappings[name='State']" targetMapping="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@containerMappings[name='State']" targetFinderExpression="feature:nextState" sourceFinderExpression="feature:currentState" domainClass="mncModel.Transition" useDomainElement="true" reconnections="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='TransitionReconnect']">
          <style targetArrow="InputFillClosedArrow" sizeComputationExpression="2">
            <strokeColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <centerLabelStyleDescription showIcon="false" labelExpression="aql:self.eContainer().eContainer().command.name">
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="startingedge" sourceMapping="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@nodeMappings[name='StartingPoint']" targetMapping="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@containerMappings[name='State']" targetFinderExpression="feature:startState">
          <style sizeComputationExpression="3">
            <strokeColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.4"/>
            <centerLabelStyleDescription showIcon="false">
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings name="Endingedge" sourceMapping="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@nodeMappings[name='EndingPoint']" targetMapping="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@containerMappings[name='State']" targetFinderExpression="feature:endState">
          <style sourceArrow="InputArrow" targetArrow="NoDecoration" sizeComputationExpression="3">
            <strokeColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.6"/>
            <centerLabelStyleDescription showIcon="false">
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <containerMappings name="State" labelDirectEdit="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='EditStateName']" semanticCandidatesExpression="feature:eAllContents" domainClass="mncModel.OperatingState" childrenPresentation="VerticalStack">
          <subContainerMappings name="EntryAction" semanticCandidatesExpression="service:getEntryActionTransition()" domainClass="mncModel.Transition">
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" borderSizeComputationExpression="3" showIcon="false" labelExpression="service:getEntryActionName()" tooltipExpression="aql:'Entry Action Of '+ self.eContainer().eContainer().command.name+' Transition of '+self.currentState.name+' State '" widthComputationExpression="3" heightComputationExpression="3">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.4"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.4"/>
            </style>
          </subContainerMappings>
          <subContainerMappings name="ExitAction" semanticCandidatesExpression="service:getExitActionTransition()" domainClass="mncModel.Transition">
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" borderSizeComputationExpression="3" showIcon="false" labelExpression="service:getExitActionName()" tooltipExpression="aql:'Exit Action due to '+ self.eContainer().eContainer().command.name+' Transition to '+self.nextState.name+' State '" widthComputationExpression="3" heightComputationExpression="3">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.6"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.6"/>
            </style>
          </subContainerMappings>
          <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="50" arcHeight="50" borderSizeComputationExpression="3" showIcon="false" labelExpression="aql:'  \n '+self.name+' '" tooltipExpression="OperatingState" roundedCorner="true">
            <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.3"/>
            <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.3"/>
            <labelBorderStyle href="environment:/viewpoint#//@labelBorderStyles/@labelBorderStyleDescriptions.2"/>
          </style>
        </containerMappings>
        <containerMappings name="DiagramInformation" semanticCandidatesExpression="feature:eAllContents" domainClass="mncModel.InterfaceDescription" childrenPresentation="VerticalStack">
          <subContainerMappings name="EntryActionInformation" semanticCandidatesExpression="feature:eAllContents" domainClass="utility.StateUtility">
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" borderSizeComputationExpression="1" showIcon="false" labelExpression="aql:' EntryAction '" widthComputationExpression="5" heightComputationExpression="2">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.6"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.6"/>
            </style>
          </subContainerMappings>
          <subContainerMappings name="ExitActionInformation" semanticCandidatesExpression="feature:eAllContents" domainClass="utility.StateUtility">
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" borderSizeComputationExpression="1" showIcon="false" labelExpression="aql:'ExitAction '" widthComputationExpression="5" heightComputationExpression="2">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.4"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.4"/>
            </style>
          </subContainerMappings>
          <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" borderSizeComputationExpression="4" labelSize="10" showIcon="false" labelExpression="aql:'Diagram Information'">
            <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <labelFormat>bold</labelFormat>
            <labelFormat>underline</labelFormat>
            <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.3"/>
            <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.3"/>
          </style>
        </containerMappings>
        <toolSections>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="CreateState" label="Create New State" forceRefresh="true" elementsToSelect="aql:self" containerMappings="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@containerMappings[name='State']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="service:getNewOperatingStateContext()">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="mncModel.OperatingState" referenceName="operatingStates">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'State'+self.siblings()->size()"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="TransitionEdge" label="Create new Transition" precondition="aql:mncModel::OperatingState" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='ActionDiagram']/@ownedRepresentations[name='ActionDiagram']/@defaultLayer/@edgeMappings[name='StateTransition']" connectionStartPrecondition="aql:mncModel::OperatingState">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="service:getNewTransitionContext()">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="mncModel.Transition" referenceName="transitions">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="currentState" valueExpression="var:source"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="nextState" valueExpression="var:target"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ReconnectEdgeDescription" name="TransitionReconnect">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self">
                <subModelOperations xsi:type="tool_1:SetValue" featureName="nextState" valueExpression="var:target"/>
              </firstModelOperations>
            </initialOperation>
            <edgeView name="edgeView"/>
          </ownedTools>
          <ownedTools xsi:type="tool:DirectEditLabel" name="EditStateName">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:0"/>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DoubleClickDescription" name="ClickOnOperatingState">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="service:openTextEditor()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="com.model.domain.mnc.design.services.ActionDiagramServices"/>
  </ownedViewpoints>
  <ownedViewpoints name="DashBoard" modelFileExtension="mncspec">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="DashBoard" titleExpression="DashBoard" initialisation="true" showOnStartup="true" domainClass="mncModel.Model" preconditionExpression="service:doesDashboardNotExist()" enablePopupBars="true">
      <defaultLayer name="Default">
        <containerMappings name="OuterMostLayer" semanticCandidatesExpression="aql:self" domainClass="mncModel.Model">
          <subContainerMappings name="AddMoreElement" semanticCandidatesExpression="aql:self" doubleClickDescription="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@toolSections.0/@ownedTools[name='AddMoreElementDoubleClick']" domainClass="mncModel.Model">
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="20" arcHeight="20" borderSizeComputationExpression="1" labelSize="10" showIcon="false" labelExpression="aql:'  Add More Elements  '" roundedCorner="true" heightComputationExpression="4">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.1"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.5"/>
            </style>
          </subContainerMappings>
          <subContainerMappings name="showBlockDiagram" semanticCandidatesExpression="aql:self" domainClass="mncModel.Model" childrenPresentation="VerticalStack">
            <subContainerMappings name="showAllElementsBlockDiagram" semanticCandidatesExpression="aql:self" doubleClickDescription="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@toolSections.0/@ownedTools[name='showBlockDiagramDoubleClick']" domainClass="mncModel.Model">
              <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="20" arcHeight="20" labelSize="10" showIcon="false" labelExpression="aql:'  Show All elements '" roundedCorner="true" heightComputationExpression="4">
                <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
                <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.1"/>
                <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.5"/>
              </style>
            </subContainerMappings>
            <subContainerMappings name="showSelectiveElementsBlockDiagram" semanticCandidatesExpression="aql:self" doubleClickDescription="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@toolSections.0/@ownedTools[name='showSelectiveElementsBlockDiagramDoubleClick']" domainClass="mncModel.Model">
              <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="20" arcHeight="20" labelSize="10" showIcon="false" labelExpression="aql:'  Show Selective Elements  '" roundedCorner="true" heightComputationExpression="4">
                <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
                <labelFormat>bold</labelFormat>
                <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
                <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.1"/>
                <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.5"/>
              </style>
            </subContainerMappings>
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="20" arcHeight="20" borderSizeComputationExpression="1" labelSize="10" showIcon="false" labelExpression="aql:'  Show Block Diagram  '" roundedCorner="true" heightComputationExpression="4">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.1"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.5"/>
            </style>
          </subContainerMappings>
          <subContainerMappings name="showStateDiagram" semanticCandidatesExpression="aql:self" doubleClickDescription="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@toolSections.0/@ownedTools[name='showStateDiagramDoubleClick']" domainClass="mncModel.Model">
            <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="20" arcHeight="20" borderSizeComputationExpression="1" labelSize="10" showIcon="false" labelExpression="aql:'  Show State Diagram  '" roundedCorner="true" heightComputationExpression="4">
              <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
              <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.1"/>
              <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.5"/>
            </style>
          </subContainerMappings>
          <style xsi:type="style:FlatContainerStyleDescription" labelFormat="bold" arcWidth="20" arcHeight="20" borderSizeComputationExpression="1" labelSize="12" showIcon="false" labelExpression="aql:'  MNCML DASHBOARD  '" roundedCorner="true" heightComputationExpression="4">
            <borderColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <labelFormat>bold</labelFormat>
            <labelColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.9"/>
            <backgroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.1"/>
            <foregroundColor xsi:type="description:UserFixedColor" href="#//@userColorsPalettes.0/@entries.5"/>
          </style>
        </containerMappings>
        <toolSections name="DoubleClickSection">
          <ownedTools xsi:type="tool:DoubleClickDescription" name="AddMoreElementDoubleClick" mappings="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@containerMappings[name='OuterMostLayer']/@subContainerMappings[name='AddMoreElement']">
            <element name="element"/>
