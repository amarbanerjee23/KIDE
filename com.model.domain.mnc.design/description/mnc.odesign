          <ownedTools xsi:type="tool:DoubleClickDescription" name="showBlockDiagramDoubleClick" mappings="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@containerMappings[name='OuterMostLayer']/@subContainerMappings[name='showBlockDiagram']/@subContainerMappings[name='showAllElementsBlockDiagram']">
