          <ownedTools xsi:type="tool:DoubleClickDescription" name="showSelectiveElementsBlockDiagramDoubleClick" mappings="//@ownedViewpoints[name='DashBoard']/@ownedRepresentations[name='DashBoard']/@defaultLayer/@containerMappings[name='OuterMostLayer']/@subContainerMappings[name='showBlockDiagram']/@subContainerMappings[name='showSelectiveElementsBlockDiagram']">
            <element name="element"/>
            <elementView name="elementView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:element">
                <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="service:createSelectedElementsBlockDiagram()"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="com.model.domain.mnc.design.services.DashBoardServices"/>
