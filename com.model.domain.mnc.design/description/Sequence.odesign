<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/sequence/description/2.0.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" name="Sequence" version="10.1.3.201511131800">
  <ownedViewpoints name="SequenceDiagram" modelFileExtension="mncspec">
    <ownedRepresentations xsi:type="description_1:SequenceDiagramDescription" documentation="@generated" name="SequenceDiagramOne" titleExpression="service:getSequenceTitle()" domainClass="mncModel.Model" preconditionExpression="service:singleSequenceRepresentationCheck()" enablePopupBars="true" endsOrdering="service:getEndsOrdering()" instanceRolesOrdering="service:getInstanceRoleOrdering()">
      <defaultLayer name="Default">
        <nodeMappings xsi:type="description_1:InstanceRoleMapping" name="InstanceRoleControlNode" semanticCandidatesExpression="service:getInstanceSemanticCandidate()" domainClass="mncModel.ControlNode">
          <borderedNodeMappings xsi:type="description_1:ExecutionMapping" name="DotedLineExecution" semanticCandidatesExpression="aql:self" domainClass="mncModel.ControlNode" startingEndFinderExpression="aql:self" finishingEndFinderExpression="aql:self">
            <borderedNodeMappings xsi:type="description_1:ExecutionMapping" name="SquareExecution" semanticCandidatesExpression="feature:eAllContents" semanticElements="service:getExecutionAssociation()" domainClass="mncModel.CommandResponseBlock" reusedBorderedNodeMappings="//@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']/@borderedNodeMappings[name='SquareExecution']" startingEndFinderExpression="service:getExecutionStart()" finishingEndFinderExpression="service:getExecutionEnd()">
              <style xsi:type="style:SquareDescription" showIcon="false" labelExpression="aql:self.command.name" tooltipExpression="aql:'Execution from '+self.command.name.toUpper()+' to '+self.responseBlock.responseBlocks.response.name.toUpper()" labelPosition="node" resizeKind="NSEW" width="3" height="10">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='green']"/>
              </style>
            </borderedNodeMappings>
            <borderedNodeMappings xsi:type="description_1:EndOfLifeMapping" name="EndoOfSquareLife" semanticCandidatesExpression="aql:self" semanticElements="var:self" domainClass="mncModel.ControlNode">
              <style xsi:type="style:LozengeNodeDescription" showIcon="false" labelExpression="" labelPosition="node" resizeKind="NSEW">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
              </style>
            </borderedNodeMappings>
            <style xsi:type="style:SquareDescription" labelPosition="node" resizeKind="NSEW">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
            </style>
          </borderedNodeMappings>
          <style xsi:type="style:SquareDescription" tooltipExpression="aql:'ControlNode Instance: '+self.name" labelPosition="node" resizeKind="NSEW" width="10" height="4">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
          </style>
        </nodeMappings>
        <edgeMappings xsi:type="description_1:BasicMessageMapping" name="BasicCommandMessage" sourceMapping="//@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']/@borderedNodeMappings[name='SquareExecution'] //@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']" targetMapping="//@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']/@borderedNodeMappings[name='SquareExecution'] //@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']" targetFinderExpression="service:getTargetOfCommandMessage()" sourceFinderExpression="service:getSourceOfCommandMessage()" domainClass="mncModel.CommandResponseBlock" sendingEndFinderExpression="service:getCommandMessageSender()" receivingEndFinderExpression="service:getCommandMessageReceiver()">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelExpression="aql:self.command.name">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <edgeMappings xsi:type="description_1:BasicMessageMapping" name="BasicResponseMessage" sourceMapping="//@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']/@borderedNodeMappings[name='SquareExecution'] //@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']" targetMapping="//@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']/@borderedNodeMappings[name='SquareExecution'] //@ownedViewpoints[name='SequenceDiagram']/@ownedRepresentations[name='SequenceDiagramOne']/@defaultLayer/@nodeMappings[name='InstanceRoleControlNode']/@borderedNodeMappings[name='DotedLineExecution']" targetFinderExpression="service:getTargetOfResponseMessage()" sourceFinderExpression="service:getSourceOfResponseMessage()" domainClass="mncModel.CommandResponseBlock" sendingEndFinderExpression="service:getResponseMessageSender()" receivingEndFinderExpression="service:getResponseMessageReceiver()">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
            <centerLabelStyleDescription labelExpression="aql:self.command.name">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="com.model.domain.mnc.design.services.SequenceDiagramServices"/>
  </ownedViewpoints>
</description:Group>
