Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: com.operation;singleton:=true
Automatic-Module-Name: com.operation
Bundle-Version: 0.1.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-11
Export-Package: operationsDescription,
 operationsDescription.impl,
 operationsDescription.util
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 com.dml;visibility:=reexport,
 com.mncml;visibility:=reexport
Bundle-ActivationPolicy: lazy
